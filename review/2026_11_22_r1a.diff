+
+import org.apache.asterix.column.filter.FilterAccessorProvider;
+import org.apache.asterix.column.values.IColumnValuesReader;
+import org.apache.asterix.dataflow.data.nontagged.comparators.AGenericAscBinaryComparatorFactory;
+import org.apache.asterix.om.types.ARecordType;
+import org.apache.asterix.om.types.ATypeTag;
+import org.apache.asterix.om.types.BuiltinType;
+import org.apache.asterix.runtime.operators.plaque.PlaqueThresholdRegistry;
+import org.apache.asterix.runtime.operators.plaque.PlaqueThresholdState;
+import org.apache.hyracks.algebricks.runtime.base.IScalarEvaluator;
+import org.apache.hyracks.api.context.IHyracksTaskContext;
+import org.apache.hyracks.api.dataflow.value.IBinaryComparator;
+import org.apache.hyracks.api.exceptions.HyracksDataException;
+import org.apache.hyracks.data.std.api.IPointable;
+import org.apache.hyracks.data.std.primitive.VoidPointable;
+
+/**
+ * PLAQUE scalar MAX / MIN inside a native columnar scan: a row whose value cannot beat the best value found so far is
+ * dropped. This is the test of the PLAQUE tuple filter above the scan (same state, same comparator, an equal value
+ * dropped), asked before the row is assembled. Null and missing values are kept.
+ * <p>
+ * Where the column holds arrays in this component, the reader hands out one value per array element, not the row's
+ * value; the test is then not used on that component and counts a decline.
+ * <p>
+ * With {@code keepAll} it keeps every row. It goes with the native MAX/MIN page skip when the row test is switched
+ * off: a scan without a row filter returns the rows of a leaf it did not read as empty records, and only a scan with
+ * a row filter leaves them out (the same reason as for the DISTINCT leaf skip).
+ */
+public class PlaqueMinMaxRowTest implements IPlaqueRowTest {
+    private static final long serialVersionUID = 1L;
+    private final String handle;
+    private final boolean isMax;
+    private final ARecordType columnPath;
+    private final boolean keepAll;
+
+    public PlaqueMinMaxRowTest(String handle, boolean isMax, ARecordType columnPath, boolean keepAll) {
+        this.handle = handle;
+        this.isMax = isMax;
+        this.columnPath = columnPath;
+        this.keepAll = keepAll;
+    }
+
+    @Override
+    public IScalarEvaluator create(FilterAccessorProvider provider, IHyracksTaskContext ctx)
+            throws HyracksDataException {
+        boolean repeated =
+                provider.getOrCreateColumnReaders(columnPath).stream().anyMatch(IColumnValuesReader::isRepeated);
+        IScalarEvaluator value = provider.createColumnAccessEvaluator(columnPath);
+        if (keepAll) {
+            return (tuple, result) -> PlaqueRowFilterEvaluatorFactory.keep(result, true);
+        }
+        if (ctx == null) {
+            return null;
+        }
+        PlaqueThresholdState state =
+                PlaqueThresholdRegistry.INSTANCE.getOrCreate(ctx.getJobletContext().getJobId(), handle, isMax);
+        if (repeated) {
+            state.scanRowTestDeclines.increment();
+            return null;
+        }
+        return canBeat(value, state);
+    }
+
+    /** True for a null or missing value or one that beats the state's best value; false (and counted) otherwise. */
+    static IScalarEvaluator canBeat(IScalarEvaluator value, PlaqueThresholdState state) {
+        IPointable v = new VoidPointable();
+        IBinaryComparator cmp =
+                new AGenericAscBinaryComparatorFactory(BuiltinType.ANY, BuiltinType.ANY).createBinaryComparator();
+        return (tuple, result) -> {
+            value.evaluate(tuple, v);
+            byte tag = v.getByteArray()[v.getStartOffset()];
+            if (tag == ATypeTag.SERIALIZED_MISSING_TYPE_TAG || tag == ATypeTag.SERIALIZED_NULL_TYPE_TAG) {
+                PlaqueRowFilterEvaluatorFactory.keep(result, true);
+                return;
+            }
+            state.scanRowsTested.increment();
+            boolean keep = state.passes(v.getByteArray(), v.getStartOffset(), v.getLength(), cmp, true);
+            if (!keep) {
+                state.scanRowsDropped.increment();
+            }
+            PlaqueRowFilterEvaluatorFactory.keep(result, keep);
+        };
+    }
+
+    @Override
+    public String toString() {
+        return (isMax ? "MAX(" : "MIN(") + handle + (keepAll ? ", keep all)" : ")");
+    }
+}

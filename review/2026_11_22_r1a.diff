+/** The PLAQUE MAX / MIN row test inside the Iceberg reader. */
+public class PlaqueIcebergRowTestTest {
+
+    private static final Schema SCHEMA = new Schema(Types.NestedField.required(1, "k", Types.LongType.get()),
+            Types.NestedField.optional(2, "i", Types.IntegerType.get()),
+            Types.NestedField.optional(3, "f", Types.FloatType.get()),
+            Types.NestedField.optional(4, "d", Types.DoubleType.get()),
+            Types.NestedField.optional(5, "s", Types.StringType.get()));
+    private static final int ROWS = 20_000;
+    private static final String HANDLE = "h";
+    private static final JobId JOB = new JobId(987654332L);
+
+    @After
+    public void cleanUp() {
+        PlaqueThresholdRegistry.INSTANCE.removeJob(JOB);
+    }
+
+    @Test
+    public void noRowTestForAQueryWithoutOneOrAnUnsupportedColumn() {
+        Assert.assertNull(PlaqueIcebergRowTest.create(new HashMap<>(), SCHEMA, ctx()));
+        Assert.assertNull(PlaqueIcebergRowTest.create(config("s", true), SCHEMA, ctx()));
+        Assert.assertNull(PlaqueIcebergRowTest.create(config("nope", true), SCHEMA, ctx()));
+        for (String c : new String[] { "k", "i", "f", "d" }) {
+            Assert.assertNotNull(c, PlaqueIcebergRowTest.create(config(c, true), SCHEMA, ctx()));
+        }
+    }
+
+    @Test
+    public void theValueIsWrittenAsTheParserWouldWriteIt() throws Exception {
+        PlaqueIcebergRowTest k = PlaqueIcebergRowTest.create(config("k", true), SCHEMA, ctx());
+        PlaqueIcebergRowTest i = PlaqueIcebergRowTest.create(config("i", true), SCHEMA, ctx());
+        PlaqueIcebergRowTest f = PlaqueIcebergRowTest.create(config("f", true), SCHEMA, ctx());
+        PlaqueIcebergRowTest d = PlaqueIcebergRowTest.create(config("d", true), SCHEMA, ctx());
+        for (long v : new long[] { 0, -1, 42, Long.MIN_VALUE, Long.MAX_VALUE }) {
+            Assert.assertArrayEquals(int64(v), Arrays.copyOf(k.value(), k.write(v)));
+        }
+        for (int v : new int[] { 0, -7, Integer.MAX_VALUE }) {
+            Assert.assertArrayEquals("int is read as BIGINT", int64(v), Arrays.copyOf(i.value(), i.write(v)));
+        }
+        for (float v : new float[] { 0f, -0f, 1.5f, Float.NaN, Float.NEGATIVE_INFINITY }) {
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            DataOutputStream out = new DataOutputStream(bos);
+            out.writeByte(ATypeTag.SERIALIZED_FLOAT_TYPE_TAG);
+            AFloatSerializerDeserializer.INSTANCE.serialize(new AFloat(v), out);
+            Assert.assertArrayEquals(bos.toByteArray(), Arrays.copyOf(f.value(), f.write(v)));
+        }
+        for (double v : new double[] { 0d, -0d, 2.25, Double.NaN, Double.MAX_VALUE }) {
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            DataOutputStream out = new DataOutputStream(bos);
+            out.writeByte(ATypeTag.SERIALIZED_DOUBLE_TYPE_TAG);
+            ADoubleSerializerDeserializer.INSTANCE.serialize(new ADouble(v), out);
+            Assert.assertArrayEquals(bos.toByteArray(), Arrays.copyOf(d.value(), d.write(v)));
+        }
+    }
+
+    @Test
+    public void maxDropsEqualAndWorseRowsAndKeepsBetterAndNullOnes() throws Exception {
+        PlaqueThresholdState state = PlaqueThresholdRegistry.INSTANCE.getOrCreate(JOB, HANDLE, true);
+        PlaqueIcebergRowTest t = PlaqueIcebergRowTest.create(config("d", true), SCHEMA, ctx());
+        Assert.assertTrue("no best value yet", t.keep(row(1, 1.0)));
+        state.update(dbl(10.0), 0, 9);
+        Assert.assertFalse("worse", t.keep(row(2, 9.0)));
+        Assert.assertFalse("equal", t.keep(row(3, 10.0)));
+        Assert.assertTrue("better", t.keep(row(4, 10.5)));
+        Assert.assertTrue("null", t.keep(row(5, null)));
+        Assert.assertEquals(4, t.tested());
+        Assert.assertEquals(2, t.dropped());
+    }
+
+    @Test
+    public void minOnAnIntColumnComparesWithTheBigintBestValue() throws Exception {
+        PlaqueThresholdState state = PlaqueThresholdRegistry.INSTANCE.getOrCreate(JOB, HANDLE, false);
+        PlaqueIcebergRowTest t = PlaqueIcebergRowTest.create(config("i", false), SCHEMA, ctx());
+        state.update(int64(100), 0, 9);
+        GenericRecord r = GenericRecord.create(SCHEMA);
+        r.setField("i", 99);
+        Assert.assertTrue(t.keep(r));
+        r.setField("i", 100);
+        Assert.assertFalse(t.keep(r));
+        r.setField("i", 101);
+        Assert.assertFalse(t.keep(r));
+    }
+
+    @Test
+    public void aFileReadThroughTheReaderKeepsExactlyTheRowsThatCanWinWithAllColumns() throws Exception {
+        File dir = Files.createTempDirectory("plaque-row-test").toFile();
+        try {
+            File file = write(dir);
+            PlaqueThresholdState state = PlaqueThresholdRegistry.INSTANCE.getOrCreate(JOB, HANDLE, true);
+            state.update(int64(ROWS - 100), 0, 9);
+            PlaqueIcebergRowTest t = PlaqueIcebergRowTest.create(config("k", true), SCHEMA, ctx());
+            List<Record> rows = new ArrayList<>();
+            try (CloseableIterable<Record> it =
+                    PlaqueIcebergRowTest.apply(t, IcebergFileRecordReader.openStandardRead(null,
+                            org.apache.iceberg.Files.localInput(file), task(file), SCHEMA, SCHEMA, null, null))) {
+                it.forEach(rows::add);
+            }
+            Assert.assertEquals(99, rows.size());
+            for (Record r : rows) {
+                long k = (Long) r.getField("k");
+                Assert.assertTrue(k > ROWS - 100);
+                Assert.assertEquals((int) k, r.getField("i"));
+                Assert.assertEquals("v" + k, r.getField("s"));
+            }
+            Assert.assertEquals(ROWS - 99, t.dropped());
+        } finally {
+            for (File f : dir.listFiles()) {
+                f.delete();
+            }
+            dir.delete();
+        }
+    }
+
+    @Test
+    public void aBestValueFoundWhileTheFileIsReadIsUsedForTheNextRows() throws Exception {
+        File dir = Files.createTempDirectory("plaque-row-test").toFile();
+        try {
+            File file = write(dir);
+            PlaqueThresholdState state = PlaqueThresholdRegistry.INSTANCE.getOrCreate(JOB, HANDLE, false);
+            PlaqueIcebergRowTest t = PlaqueIcebergRowTest.create(config("k", false), SCHEMA, ctx());
+            int kept = 0;
+            try (CloseableIterable<Record> it =
+                    PlaqueIcebergRowTest.apply(t, IcebergFileRecordReader.openStandardRead(null,
+                            org.apache.iceberg.Files.localInput(file), task(file), SCHEMA, SCHEMA, null, null))) {
+                for (Record r : it) {
+                    kept++;
+                    // what the MIN aggregate does with the first row it sees: k = 0
+                    state.update(int64((Long) r.getField("k")), 0, 9);
+                }
+            }
+            Assert.assertEquals("every row after k = 0 is dropped", 1, kept);
+        } finally {
+            for (File f : dir.listFiles()) {
+                f.delete();
+            }
+            dir.delete();
+        }
+    }
+
+    private static File write(File dir) throws Exception {
+        File file = new File(dir, "data.parquet");
+        FileAppender<Record> appender = Parquet.write(org.apache.iceberg.Files.localOutput(file)).schema(SCHEMA)
+                .createWriterFunc(GenericParquetWriter::create).overwrite().build();
+        try (FileAppender<Record> writer = appender) {
+            for (long k = 0; k < ROWS; k++) {
+                GenericRecord r = GenericRecord.create(SCHEMA);
+                r.setField("k", k);
+                r.setField("i", (int) k);
+                r.setField("f", (float) k);
+                r.setField("d", (double) k);
+                r.setField("s", "v" + k);
+                writer.add(r);
+            }
+        }
+        return file;
+    }
+
+    private static FileScanTask task(File file) {
+        FileScanTask task = Mockito.mock(FileScanTask.class);
+        Mockito.when(task.start()).thenReturn(0L);
+        Mockito.when(task.length()).thenReturn(file.length());
+        Mockito.when(task.residual()).thenReturn(Expressions.alwaysTrue());
+        return task;
+    }
+
+    private static Record row(long k, Double d) {
+        GenericRecord r = GenericRecord.create(SCHEMA);
+        r.setField("k", k);
+        r.setField("d", d);
+        return r;
+    }
+
+    private static Map<String, String> config(String field, boolean isMax) {
+        Map<String, String> c = new HashMap<>();
+        c.put(IcebergOptions.PLAQUE_ROW_TEST_HANDLE, HANDLE);
+        c.put(IcebergOptions.PLAQUE_ROW_TEST_IS_MAX, String.valueOf(isMax));
+        c.put(IcebergOptions.PLAQUE_ROW_TEST_FIELD, field);
+        return c;
+    }
+
+    private static IHyracksTaskContext ctx() {
+        IHyracksTaskContext ctx = Mockito.mock(IHyracksTaskContext.class, Mockito.RETURNS_DEEP_STUBS);
+        Mockito.when(ctx.getJobletContext().getJobId()).thenReturn(JOB);
+        return ctx;
+    }
+
+    private static byte[] int64(long v) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        DataOutputStream out = new DataOutputStream(bos);
+        out.writeByte(ATypeTag.SERIALIZED_INT64_TYPE_TAG);
+        AInt64SerializerDeserializer.INSTANCE.serialize(new AInt64(v), out);
+        return bos.toByteArray();
+    }
+
+    private static byte[] dbl(double v) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        DataOutputStream out = new DataOutputStream(bos);
+        out.writeByte(ATypeTag.SERIALIZED_DOUBLE_TYPE_TAG);
+        ADoubleSerializerDeserializer.INSTANCE.serialize(new ADouble(v), out);
+        return bos.toByteArray();
+    }

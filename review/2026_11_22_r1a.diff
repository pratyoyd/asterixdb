+package org.apache.asterix.optimizer.rules;
+
+import java.lang.reflect.Proxy;
+
+import org.apache.commons.lang3.mutable.Mutable;
+import org.apache.commons.lang3.mutable.MutableObject;
+import org.apache.hyracks.algebricks.core.algebra.base.ILogicalOperator;
+import org.apache.hyracks.algebricks.core.algebra.base.IOptimizationContext;
+import org.apache.hyracks.algebricks.core.algebra.base.LogicalVariable;
+import org.apache.hyracks.algebricks.core.algebra.expressions.ConstantExpression;
+import org.apache.hyracks.algebricks.core.algebra.functions.AlgebricksBuiltinFunctions;
+import org.apache.hyracks.algebricks.core.algebra.functions.IFunctionInfo;
+import org.apache.hyracks.algebricks.core.algebra.metadata.IMetadataProvider;
+import org.apache.hyracks.algebricks.core.algebra.operators.logical.AssignOperator;
+import org.apache.hyracks.algebricks.core.algebra.operators.logical.EmptyTupleSourceOperator;
+import org.apache.hyracks.algebricks.core.algebra.operators.logical.SelectOperator;
+import org.apache.hyracks.algebricks.rewriter.rules.ConsolidateSelectsRule;
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * A WHERE select directly above a PLAQUE select (the DISTINCT tuple filter sits below the query's WHERE) must leave
+ * both in place and must terminate; before the fix the rule looped forever on this shape.
+ */
+public class ConsolidateSelectsPlaqueTest {
+
+    @Test(timeout = 10_000)
+    public void aWhereAboveAPlaqueSelectIsLeftAloneAndTheRuleStops() throws Exception {
+        SelectOperator plaque = select(new EmptyTupleSourceOperator(), "plaque-distinct");
+        SelectOperator where = select(plaque, null);
+        Mutable<ILogicalOperator> ref = new MutableObject<>(where);
+        Assert.assertFalse(new ConsolidateSelectsRule().rewritePre(ref, context()));
+        Assert.assertSame(plaque, where.getInputs().get(0).getValue());
+    }
+
+    @Test(timeout = 10_000)
+    public void anAssignBetweenTheWhereAndThePlaqueSelectToo() throws Exception {
+        SelectOperator plaque = select(new EmptyTupleSourceOperator(), "plaque-filter");
+        AssignOperator assign =
+                new AssignOperator(new LogicalVariable(1), new MutableObject<>(ConstantExpression.TRUE));
+        assign.getInputs().add(new MutableObject<>(plaque));
+        SelectOperator where = select(assign, null);
+        Assert.assertFalse(new ConsolidateSelectsRule().rewritePre(new MutableObject<>(where), context()));
+        Assert.assertSame(plaque, assign.getInputs().get(0).getValue());
+    }
+
+    /** Only the AND function is looked up, and nothing is consolidated here. */
+    private static IOptimizationContext context() {
+        IFunctionInfo and = (IFunctionInfo) Proxy.newProxyInstance(IFunctionInfo.class.getClassLoader(),
+                new Class<?>[] { IFunctionInfo.class },
+                (o, m, a) -> m.getName().equals("getFunctionIdentifier") ? AlgebricksBuiltinFunctions.AND : null);
+        IMetadataProvider<?, ?> mp =
+                (IMetadataProvider<?, ?>) Proxy.newProxyInstance(IMetadataProvider.class.getClassLoader(),
+                        new Class<?>[] { IMetadataProvider.class },
+                        (o, m, a) -> m.getName().equals("lookupFunction") ? and : null);
+        return (IOptimizationContext) Proxy.newProxyInstance(IOptimizationContext.class.getClassLoader(),
+                new Class<?>[] { IOptimizationContext.class },
+                (o, m, a) -> m.getName().equals("getMetadataProvider") ? mp : null);
+    }
+
+    private static SelectOperator select(ILogicalOperator input, String plaqueAnnotation) {
+        SelectOperator s = new SelectOperator(new MutableObject<>(ConstantExpression.TRUE));
+        s.getInputs().add(new MutableObject<>(input));
+        if (plaqueAnnotation != null) {
+            s.getAnnotations().put(plaqueAnnotation, true);
+        }
+        return s;
+    }
+}

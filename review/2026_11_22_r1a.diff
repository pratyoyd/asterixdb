+import org.apache.asterix.column.filter.iterable.ColumnFilterEvaluatorContext;
+import org.apache.asterix.column.filter.iterable.IColumnIterableFilterEvaluator;
+import org.apache.asterix.column.filter.iterable.IColumnIterableFilterEvaluatorFactory;
+import org.apache.asterix.column.values.IColumnValuesReader;
+import org.apache.asterix.formats.nontagged.BinaryBooleanInspector;
+import org.apache.asterix.om.types.ATypeTag;
+import org.apache.hyracks.algebricks.runtime.base.IScalarEvaluator;
+import org.apache.hyracks.algebricks.runtime.base.IScalarEvaluatorFactory;
+import org.apache.hyracks.api.exceptions.HyracksDataException;
+import org.apache.hyracks.data.std.api.IPointable;
+import org.apache.hyracks.data.std.primitive.VoidPointable;
+
+/**
+ * The row filter of a native columnar scan when PLAQUE has a test for it: a row is kept only if it passes the query's
+ * own pushed-down WHERE (when there is one) and every PLAQUE test. The WHERE is asked first, so a test's counter
+ * counts only rows the WHERE would have kept. All parts read their columns through one set of filter readers, the
+ * same mechanism as {@link ColumnIterableFilterEvaluatorFactory}.
+ */
+public class PlaqueRowFilterEvaluatorFactory implements IColumnIterableFilterEvaluatorFactory {
+    private static final long serialVersionUID = 1L;
+    private static final byte[] TRUE = { ATypeTag.SERIALIZED_BOOLEAN_TYPE_TAG, 1 };
+    private static final byte[] FALSE = { ATypeTag.SERIALIZED_BOOLEAN_TYPE_TAG, 0 };
+    private final IScalarEvaluatorFactory where;
+    private final List<IPlaqueRowTest> tests;
+
+    /** @param where the query's pushed-down WHERE, {@code null} for none */
+    public PlaqueRowFilterEvaluatorFactory(IScalarEvaluatorFactory where, List<IPlaqueRowTest> tests) {
+        this.where = where;
+        this.tests = tests;
+    }
+
+    @Override
+    public IColumnIterableFilterEvaluator create(ColumnFilterEvaluatorContext context) throws HyracksDataException {
+        FilterAccessorProvider provider = context.getFilterAccessorProvider();
+        IScalarEvaluator whereEval = where == null ? null : where.createScalarEvaluator(context);
+        List<IScalarEvaluator> active = new ArrayList<>();
+        for (IPlaqueRowTest test : tests) {
+            IScalarEvaluator e = test.create(provider, context.getTaskContext());
+            if (e != null) {
+                active.add(e);
+            }
+        }
+        List<IColumnValuesReader> readers = provider.getFilterColumnReaders();
+        if (readers.isEmpty() || whereEval == null && active.isEmpty()) {
+            // this component has none of the columns, or nothing is left to test on it
+            return TrueColumnFilterEvaluator.INSTANCE;
+        }
+        IScalarEvaluator[] testEvals = active.toArray(new IScalarEvaluator[0]);
+        provider.initializeFilterReaders();
+        IScalarEvaluator all = and(whereEval, testEvals);
+        if (readers.stream().anyMatch(IColumnValuesReader::isRepeated)) {
+            return new ColumnarRepeatedIterableFilterEvaluator(all, readers);
+        }
+        return new ColumnIterableFilterEvaluator(all, readers);
+    }
+
+    /** True when where (if any) is true and every test is true; stops at the first part that is not. */
+    static IScalarEvaluator and(IScalarEvaluator where, IScalarEvaluator[] tests) {
+        IPointable r = new VoidPointable();
+        return (tuple, result) -> {
+            if (where != null) {
+                where.evaluate(tuple, r);
+                if (!BinaryBooleanInspector.getBooleanValue(r.getByteArray(), r.getStartOffset(), r.getLength())) {
+                    result.set(FALSE, 0, FALSE.length);
+                    return;
+                }
+            }
+            for (IScalarEvaluator test : tests) {
+                test.evaluate(tuple, r);
+                if (r.getByteArray()[r.getStartOffset() + 1] == 0) {
+                    result.set(FALSE, 0, FALSE.length);
+                    return;
+                }
+            }
+            result.set(TRUE, 0, TRUE.length);
+        };
+    }
+
+    static void keep(IPointable result, boolean keep) {
+        byte[] b = keep ? TRUE : FALSE;
+        result.set(b, 0, b.length);
+    }
+
+    @Override
+    public String toString() {
+        return "PLAQUE_ROW_FILTER(" + (where == null ? "" : "WHERE, ") + tests + ")";
+    }
+}

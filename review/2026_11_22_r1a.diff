+/**
+ * PLAQUE scalar MAX / MIN inside an Iceberg reader: after Iceberg has read a row and before AsterixDB converts it,
+ * a row whose value cannot beat the best value found so far is dropped. The value is written as the AsterixDB value
+ * the parser would make of it (int and long as BIGINT, float as FLOAT, double as DOUBLE) and compared by the PLAQUE
+ * tuple filter's own test (same state, same comparator, an equal value dropped). Null values are kept.
+ * <p>
+ * Only top-level int, long, float and double columns; for any other column {@link #create} returns {@code null}
+ * and says so in the log.
+ */
+final class PlaqueIcebergRowTest {
+    private static final Logger LOGGER = LogManager.getLogger();
+    private final PlaqueThresholdState state;
+    private final String field;
+    private final Type.TypeID type;
+    private final IBinaryComparator comparator =
+            new AGenericAscBinaryComparatorFactory(BuiltinType.ANY, BuiltinType.ANY).createBinaryComparator();
+    private final byte[] value = new byte[9];
+    private long tested;
+    private long dropped;
+
+    PlaqueIcebergRowTest(PlaqueThresholdState state, String field, Type.TypeID type) {
+        this.state = state;
+        this.field = field;
+        this.type = type;
+    }
+
+    /** @return the reader's row test, or {@code null} when the query has none or the column is not supported */
+    static PlaqueIcebergRowTest create(Map<String, String> configuration, Schema schema, IHyracksTaskContext ctx) {
+        String handle = configuration.get(IcebergOptions.PLAQUE_ROW_TEST_HANDLE);
+        String name = configuration.get(IcebergOptions.PLAQUE_ROW_TEST_FIELD);
+        if (handle == null || name == null) {
+            return null;
+        }
+        Types.NestedField f = schema.asStruct().field(name);
+        Type.TypeID id = f == null ? null : f.type().typeId();
+        if (id != Type.TypeID.INTEGER && id != Type.TypeID.LONG && id != Type.TypeID.FLOAT
+                && id != Type.TypeID.DOUBLE) {
+            LOGGER.info("plaque iceberg row test off: column {} has type {}", name, f == null ? "none" : f.type());
+            return null;
+        }
+        boolean isMax = Boolean.parseBoolean(configuration.get(IcebergOptions.PLAQUE_ROW_TEST_IS_MAX));
+        return new PlaqueIcebergRowTest(
+                PlaqueThresholdRegistry.INSTANCE.getOrCreate(ctx.getJobletContext().getJobId(), handle, isMax), name,
+                id);
+    }
+
+    /** The rows of one file with this test applied; {@code rows} itself when test is {@code null}. */
+    static CloseableIterable<Record> apply(PlaqueIcebergRowTest test, CloseableIterable<Record> rows) {
+        return test == null ? rows : CloseableIterable.filter(rows, test::keep);
+    }
+
+    boolean keep(Record r) {
+        Object v = r.getField(field);
+        if (v == null) {
+            return true;
+        }
+        tested++;
+        int len = write(v);
+        boolean keep;
+        try {
+            keep = state.passes(value, 0, len, comparator, true);
+        } catch (HyracksDataException e) {
+            throw new IllegalStateException(e);
+        }
+        if (!keep) {
+            dropped++;
+        }
+        return keep;
+    }
+
+    /** Writes v into value as the AsterixDB value the Iceberg parser makes of it; returns its length. */
+    int write(Object v) {
+        switch (type) {
+            case INTEGER:
+                return putLong(ATypeTag.SERIALIZED_INT64_TYPE_TAG, (Integer) v);
+            case LONG:
+                return putLong(ATypeTag.SERIALIZED_INT64_TYPE_TAG, (Long) v);
+            case DOUBLE:
+                return putLong(ATypeTag.SERIALIZED_DOUBLE_TYPE_TAG, Double.doubleToLongBits((Double) v));
+            default: // FLOAT
+                int bits = Float.floatToIntBits((Float) v);
+                value[0] = ATypeTag.SERIALIZED_FLOAT_TYPE_TAG;
+                for (int i = 0; i < 4; i++) {
+                    value[1 + i] = (byte) (bits >>> (24 - 8 * i));
+                }
+                return 5;
+        }
+    }
+
+    byte[] value() {
+        return value;
+    }
+
+    private int putLong(byte tag, long bits) {
+        value[0] = tag;
+        for (int i = 0; i < 8; i++) {
+            value[1 + i] = (byte) (bits >>> (56 - 8 * i));
+        }
+        return 9;
+    }
+
+    long tested() {
+        return tested;
+    }
+
+    long dropped() {
+        return dropped;
+    }
+
+    /** Logs this reader's counts and adds them to the job's counters. */
+    void report(int tasks) {
+        LOGGER.info("plaque iceberg row test: {} tasks, {} rows dropped of {} tested on column {}", tasks, dropped,
+                tested, field);
+        state.scanRowsTested.add(tested);
+        state.scanRowsDropped.add(dropped);
+    }
+}
